# ---- LOGISENSE AI :: backend configuration -------------------------------
# Copy this file to `.env` and adjust as needed. Never commit real secrets.

# PostgreSQL connection string. If the server is unreachable the app falls
# back to a local SQLite file (backend/data/logisense.db) so the demo runs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logisense

# Set to false to disable the SQLite fallback.
SQLITE_FALLBACK=true

# Use only synthetic data + the locally trained ML model.
DEMO_MODE=true

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional external weather provider. Leave blank for the synthetic feed.
WEATHER_API_KEY=
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Seed used for reproducible synthetic data generation.
RANDOM_SEED=42
